<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Share link</title>
</head>
<body>
  <h1>Share link for <%= folder.name %></h1>

  <p>Anyone with this link can view the folder until
     <%= share.expiresAt.toLocaleString() %>.</p>

  <p><code>/share/<%= share.token %></code></p>

  <a href="/folders/<%= folder.id %>">Back to folder</a>
</body>
</html>