<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="/favicon.svg">
  <title>File Uploader</title>
</head>
<body>
  <% if (currentUser) { %>
    <div class="topbar">
      <h1>File Uploader</h1>
      <div class="actions">
        <p class="muted-text">Logged in as <%= currentUser.username %></p>
        <form action="/log-out" method="POST" class="inline">
          <button type="submit" class="btn btn-secondary btn-sm">Log out</button>
        </form>
      </div>
    </div>

    <h2>Your folders</h2>
    <% if (folders.length === 0) { %>
      <p class="empty-state">No folders yet.</p>
    <% } else { %>
      <ul>
        <% folders.forEach((folder) => { %>
          <li><a href="/folders/<%= folder.id %>"><%= folder.name %></a></li>
        <% }); %>
      </ul>
    <% } %>

    <a href="/folders/new" class="btn mt-lg">New folder</a>
  <% } else { %>
    <h1>File Uploader</h1>
    <div class="auth-card">
      <p class="muted-text mb-lg">Store and share your files securely.</p>
      <div class="file-actions">
        <a href="/log-in" class="btn">Log in</a>
        <a href="/sign-up" class="btn btn-secondary">Sign up</a>
      </div>
    </div>
  <% } %>
</body>
</html>
