<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rename Folder</title>
</head>
<body>
  <h1>Rename Folder</h1>

  <% if (locals.errors) { %>
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error.msg %></li>
      <% }); %>
    </ul>
  <% } %>

  <form action="/folders/<%= folder.id %>/edit" method="POST">
    <label for="name">Folder name</label>
    <input id="name" name="name" type="text" value="<%= folder.name %>" required />

    <button type="submit">Save</button>
  </form>

  <a href="/folders/<%= folder.id %>">Cancel</a>
</body>
</html>