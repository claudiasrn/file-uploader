<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="/favicon.svg">
  <title><%= share.folder.name %></title>
</head>
<body>
  <h1><%= share.folder.name %></h1>
  <p class="muted-text">Shared folder — read only.</p>

  <% if (share.folder.files.length === 0) { %>
    <p class="empty-state">This folder is empty.</p>
  <% } else { %>
    <ul>
      <% share.folder.files.forEach((file) => { %>
        <li>
          <span><%= file.name %> <small>(<%= formatSize(file.size) %>)</small></span>
          <a class="btn btn-sm" href="/share/<%= share.token %>/files/<%= file.id %>">Download</a>
        </li>
      <% }); %>
    </ul>
  <% } %>
</body>
</html>