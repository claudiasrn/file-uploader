<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/styles.css">
        <link rel="icon" href="/favicon.svg">
		<title><%= file.name %></title>
	</head>
	<body>
		<h1><%= file.name %></h1>

		<dl>
			<dt>Size</dt>
			<dd><%= formatSize(file.size) %></dd>

			<dt>Type</dt>
			<dd><%= file.mimetype %></dd>

			<dt>Uploaded</dt>
			<dd><%= file.createdAt.toLocaleString() %></dd>
		</dl>

		<a href="/files/<%= file.id %>/download">Download</a>

		<form action="/files/<%= file.id %>/delete" method="POST">
			<button type="submit">Delete</button>
		</form>

		<a href="/folders/<%= file.folder.id %>">Back to <%= file.folder.name %></a>
	</body>
</html>
