<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" href="/styles.css" />
		<link rel="icon" href="/favicon.svg" />
		<title><%= file.name %></title>
	</head>
	<body>
		<h1><%= file.name %></h1>

		<dl>
			<dt>Size</dt>
			<dd><%= formatSize(file.size) %></dd>

			<dt>Type</dt>
			<dd><%= file.mimetype %></dd>

			<dt>Uploaded</dt>
			<dd><%= file.createdAt.toLocaleString() %></dd>
		</dl>

		<div class="file-actions">
			<a class="btn" href="/files/<%= file.id %>/download">Download</a>

			<form action="/files/<%= file.id %>/delete" method="POST" class="inline">
				<button type="submit" class="btn-danger">Delete</button>
			</form>
		</div>

		<a href="/folders/<%= file.folder.id %>" class="back-link"
			>← Back to <%= file.folder.name %></a
		>
	</body>
</html>
